{
  "name": "archyndium-browser",
  "productName": "ARCHYNDIUM Browser",
  "version": "0.1.0",
  "description": "音楽と歌詞を楽しみながら使える、デザイン重視のデスクトップブラウザ",
  "author": "archyndium",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/archyndium/archyndium-browser#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/archyndium/archyndium-browser.git"
  },
  "bugs": {
    "url": "https://github.com/archyndium/archyndium-browser/issues"
  },
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:store": "electron-builder --win appx",
    "notices": "node scripts/notices.js",
    "icons": "electron scripts/make-icons.js"
  },
  "dependencies": {
    "@cliqz/adblocker-electron": "^1.34.0",
    "cross-fetch": "^4.0.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.archyndium.browser",
    "productName": "ARCHYNDIUM Browser",
    "copyright": "Copyright © 2026 archyndium",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "TRADEMARKS.md",
        "to": "TRADEMARKS.md"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ARCHYNDIUM-Browser-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ARCHYNDIUM Browser",
      "artifactName": "ARCHYNDIUM-Browser-Setup-${version}.${ext}"
    },
    "appx": {
      "applicationId": "ArchyndiumBrowser",
      "identityName": "REPLACE_WITH_PARTNER_CENTER_IDENTITY_NAME",
      "publisher": "CN=REPLACE_WITH_PARTNER_CENTER_PUBLISHER_ID",
      "publisherDisplayName": "archyndium",
      "displayName": "ARCHYNDIUM Browser",
      "languages": [
        "ja-JP",
        "en-US"
      ],
      "backgroundColor": "#17171a",
      "artifactName": "ARCHYNDIUM-Browser-${version}-store.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "draft"
      }
    ]
  }
}
